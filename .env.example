# Salin file ini menjadi .env.local lalu isi nilainya.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di server (API routes). Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password login dosen/admin di /admin/login
ADMIN_PASSWORD=

# Opsional: URL deployment Vercel untuk QR Code, contoh https://website-kamu.vercel.app
# Jika kosong, QR memakai alamat situs yang sedang dibuka admin.
NEXT_PUBLIC_SITE_URL=
